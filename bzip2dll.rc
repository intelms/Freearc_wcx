                    WS_TABSTOP
    DEFPUSHBUTTON   "OK",104,36,98,40,14
    PUSHBUTTON      "Cancel",2,86,98,40,14
    GROUPBOX        "Copyright",106,5,2,148,47
    LTEXT           "BZIP-DLL:\nCopyright © 1999-2010 by Christian Ghisler\nLibrary:\nCopyright © 1996-2008 Julian R Seward",
                    100,11,12,139,33
    LTEXT           "Warning: high rates may be very slow!",107,11,78,131,8
END


